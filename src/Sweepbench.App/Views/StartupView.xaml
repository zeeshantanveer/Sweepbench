<UserControl x:Class="Sweepbench.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Sweepbench.App.ViewModels"
             xmlns:conv="clr-namespace:Sweepbench.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}">

    <UserControl.Resources>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Startup" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="Toggling here writes the same flag Task Manager's Startup tab does — nothing is deleted."
                           Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Scan" Command="{Binding ScanCommand}"
                    Style="{StaticResource AccentButtonStyle}" Padding="16,9" VerticalAlignment="Top" />
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8"
                Background="{StaticResource SurfaceBrush}">
            <Grid>
                <TextBlock Text="No items yet — click Scan to list startup programs."
                           Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                                <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="10,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Command="{Binding ToggleCommand}"
                                                  Style="{StaticResource SweepCheckBoxStyle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Command}" Style="{StaticResource MutedTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource CriticalBrush}"
                                                       FontSize="11.5" Margin="0,2,0,0"
                                                       Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibilityConverter}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding LocationLabel}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" FontSize="12" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" Margin="0,16,0,0" />
    </Grid>
</UserControl>
