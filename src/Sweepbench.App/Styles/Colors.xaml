<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sweepbench palette — mirrors the design artifact: graphite ground, teal accent. -->
    <Color x:Key="BgColor">#12161A</Color>
    <Color x:Key="SurfaceColor">#181E23</Color>
    <Color x:Key="Surface2Color">#1F262B</Color>
    <Color x:Key="BorderColor">#2B333B</Color>
    <Color x:Key="TextColor">#E7ECEE</Color>
    <Color x:Key="TextMutedColor">#8D9AA3</Color>
    <Color x:Key="AccentColor">#3FD0B4</Color>
    <Color x:Key="AccentSoftColor">#173832</Color>
    <Color x:Key="CriticalColor">#EA7A72</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />

</ResourceDictionary>
