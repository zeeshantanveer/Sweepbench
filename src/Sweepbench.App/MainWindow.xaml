<Window x:Class="Sweepbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sweepbench.App"
        xmlns:vm="clr-namespace:Sweepbench.App.ViewModels"
        xmlns:conv="clr-namespace:Sweepbench.App.Converters"
        mc:Ignorable="d"
        Title="Sweepbench" Height="640" Width="920" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <StackPanel Margin="14,18">
                <TextBlock Margin="6,0,0,22" FontWeight="Bold" FontSize="14">
                    <Run Text="sweep" />
                    <Run Text="bench" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>

                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,2">
                    <TextBlock Text="Health Check" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </Border>

                <TextBlock Text="Registry" Foreground="{StaticResource TextMutedBrush}" Padding="10,8" Opacity="0.5"
                           ToolTip="Coming in Phase 2" />
                <TextBlock Text="Startup" Foreground="{StaticResource TextMutedBrush}" Padding="10,8" Opacity="0.5"
                           ToolTip="Coming in Phase 2" />
                <TextBlock Text="Uninstall" Foreground="{StaticResource TextMutedBrush}" Padding="10,8" Opacity="0.5"
                           ToolTip="Coming in Phase 2" />
                <TextBlock Text="Duplicates" Foreground="{StaticResource TextMutedBrush}" Padding="10,8" Opacity="0.5"
                           ToolTip="Coming in Phase 3" />
                <TextBlock Text="Disk Map" Foreground="{StaticResource TextMutedBrush}" Padding="10,8" Opacity="0.5"
                           ToolTip="Coming in Phase 3" />
                <TextBlock Text="Erase" Foreground="{StaticResource TextMutedBrush}" Padding="10,8" Opacity="0.5"
                           ToolTip="Coming in Phase 3" />
            </StackPanel>
        </Border>

        <!-- ===== Main content ===== -->
        <Grid Grid.Column="1" Margin="26,22,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Health Check" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding FreeSpaceText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Scan" Command="{Binding ScanCommand}"
                        Style="{StaticResource AccentButtonStyle}" Padding="16,9" VerticalAlignment="Top" />
            </Grid>

            <!-- Gauge -->
            <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedSizeText}" Foreground="{StaticResource AccentBrush}"
                                   FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="recoverable, selected" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Margin="18,0" Height="7" Minimum="0"
                                 Maximum="{Binding TotalCount}" Value="{Binding SelectedCount, Mode=OneWay}"
                                 VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource BorderBrush2}" BorderThickness="0" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}">
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding TotalCount, Mode=OneWay}" />
                        <Run Text=" items checked" />
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Item list -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8"
                    Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <TextBlock Text="No items yet — click Scan to check for reclaimable space."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding TotalCount, Converter={StaticResource ZeroToVisibilityConverter}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CleanItemViewModel}">
                                    <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="10,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      Style="{StaticResource SweepCheckBoxStyle}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" FontFamily="Consolas" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding CleanCommand}" Style="{StaticResource AccentButtonStyle}">
                    <TextBlock>
                        <Run Text="Clean " />
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                        <Run Text=" item(s)" />
                    </TextBlock>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
